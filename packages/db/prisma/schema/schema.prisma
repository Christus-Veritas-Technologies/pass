generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  STUDY
  PASS
}

enum ResourceType {
  PAST_PAPER
  MARKING_GUIDE
  SYLLABUS
}

enum SessionMode {
  GUIDE
  FREE
}

// Lifecycle of a Resource through the offline ingestion pipeline.
enum IngestStatus {
  PENDING // registered, not yet processed
  TEXT_EXTRACTED // local text extraction succeeded, awaiting AI structuring
  NEEDS_VISION // PDF is an image scan — needs Claude PDF-vision
  INGESTED // questions + AI model answers stored
  FAILED // processing failed — see ingestError
}

// Where a question's marking rubric came from.
enum GuideSource {
  AI_GENERATED // best-effort rubric produced at ingestion
  OFFICIAL // official ZIMSEC marking scheme attached later
}

// Subscription status for tracking active/expired plans.
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Whether a subscription was purchased monthly or annually.
enum BillingCycle {
  MONTHLY
  ANNUAL
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String? // null for Google-only accounts
  googleId     String? @unique
  school       String?
  grade        String?
  plan         Plan    @default(FREE)

  // WhatsApp linking
  phone            String?                  // E.164, e.g. "+263771234567"
  whatsappId       String?   @unique        // wwebjs chat id, e.g. "263771234567@c.us"
  whatsappLinkedAt DateTime?

  // Referral bonus credits (lifetime pool, decremented when monthly limit is exceeded)
  bonusPapers   Int @default(0)
  bonusProjects Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authSessions         Session[]
  passwordResetTokens  PasswordResetToken[]
  paperSessions        PaperSession[]
  projects             Project[]
  monthlyUsages        MonthlyUsage[]
  subscription         Subscription?
  paymentTransactions  PaymentTransaction[]
  whatsappConversation WhatsappConversation?
  whatsappLinkCodes    WhatsappLinkCode[]

  // Referral system
  referralCode     ReferralCode?
  referralsMade    ReferralRedemption[] @relation("ReferralsMade")
  referralReceived ReferralRedemption?  @relation("ReferralsReceived")

  // Notifications
  webPushSubscriptions WebPushSubscription[]
  devicePushTokens     DevicePushToken[]
  notificationSettings NotificationSettings?
}

// Stores one row per active refresh token. Deleting a row = revoking that session.
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resource {
  id        String       @id @default(cuid())
  title     String
  subject   String
  grade     String
  year      Int
  type      ResourceType
  fileUrl   String
  createdAt DateTime     @default(now())

  // ─── Ingestion metadata (past papers only) ──────────────────────────────────
  paperCode     String?      @unique // natural upsert key — ZIMSEC code or synthetic slug
  filePath      String? // repo-relative path to the source PDF
  pageCount     Int?
  ingestStatus  IngestStatus @default(PENDING)
  ingestError   String?
  questionCount Int          @default(0)
  ingestedAt    DateTime?

  paperSessions PaperSession[]
  questions     PaperQuestion[]
}

// One extracted question from a past-paper PDF. Produced once by the offline
// ingestion pipeline and reused by every study session at zero AI cost.
model PaperQuestion {
  id             String      @id @default(cuid())
  resourceId     String
  questionNumber Int
  text           String // full question stem
  marks          Int         @default(0)
  subParts       Json? // [{ label: "(a)", text, marks }]
  section        String? // "Section A" / "Section B"
  topic          String?
  pdfPage        Int? // page in the source PDF — for diagram deep-linking
  hasDiagram     Boolean     @default(false)
  diagramNote    String? // describes the figure the question depends on
  aiModelAnswer  String // best-effort rubric — ALWAYS generated at ingestion
  officialGuide  String? // official ZIMSEC marking scheme — attached later
  guideSource    GuideSource @default(AI_GENERATED)
  createdAt      DateTime    @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, questionNumber])
  @@index([resourceId])
}

model PaperSession {
  id                String      @id @default(cuid())
  userId            String
  resourceId        String
  mode              SessionMode
  questionsAnswered Int         @default(0)
  completedAt       DateTime?
  createdAt         DateTime    @default(now())

  user             User              @relation(fields: [userId], references: [id])
  resource         Resource          @relation(fields: [resourceId], references: [id])
  questionAttempts QuestionAttempt[]
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  sessionId      String
  questionNumber Int
  questionText   String
  userAnswer     String
  evaluation     Json?
  explanation    String?
  correct        Boolean?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session PaperSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionNumber])
}

model Project {
  id              String   @id @default(cuid())
  userId          String
  grade           String
  subject         String
  topic           String
  content         String
  pdfUrl          String?
  centreNumber    String   @default("")
  candidateNumber String   @default("")
  category        String   @default("")
  studentName     String   @default("")
  schoolName      String   @default("")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model MonthlyUsage {
  id             String @id @default(cuid())
  userId         String
  month          String
  papersUsed     Int    @default(0)
  projectsUsed   Int    @default(0)
  aiMessagesUsed Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

// One row per WhatsApp chat. Holds the multi-turn conversation state machine.
model WhatsappConversation {
  id            String   @id @default(cuid())
  userId        String?  @unique             // null until account is linked
  whatsappId    String   @unique             // wwebjs chat id, e.g. "263771234567@c.us"
  state         Json     @default("{}")      // ConversationState JSON
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([whatsappId])
}

// Short-lived one-time codes for linking a WhatsApp number to a web/native account.
model WhatsappLinkCode {
  id         String    @id @default(cuid())
  userId     String
  code       String    @unique            // 6-digit numeric string
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Tracks active subscriptions for users on paid plans (STUDY, PASS).
model Subscription {
  id         String               @id @default(cuid())
  userId     String               @unique
  plan       Plan                 // STUDY or PASS
  status     SubscriptionStatus   @default(ACTIVE)

  // Billing & Renewal
  billingCycle BillingCycle @default(MONTHLY)
  startDate  DateTime
  expiryDate DateTime             // When subscription expires
  renewalDue Boolean              @default(false)  // Prompt user to renew

  // Paynow Reference
  paynowRef  String?              @unique  // Paynow transaction reference
  paynowStatus String?                     // "paid", "pending", "failed"

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiryDate])
}

// Tracks all payment transactions through Paynow.
model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float          // In ZWL
  currency    String   @default("ZWL")
  plan        Plan           // Which plan being purchased

  billingCycle BillingCycle @default(MONTHLY)

  // Paynow Details
  paynowRef   String?  @unique  // Transaction reference from Paynow (set after Paynow responds)
  redirectUrl String?           // URL user was redirected to
  pollUrl     String?           // URL for polling transaction status
  status      String           // "pending", "paid", "failed"

  // Audit
  createdAt DateTime @default(now())
  paidAt    DateTime?         // When payment confirmed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── Referral system ──────────────────────────────────────────────────────────

// One referral code per user, auto-generated on account creation.
model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tracks each successful referred signup. refereeId is unique — one redemption per new user.
model ReferralRedemption {
  id            String   @id @default(cuid())
  referrerId    String
  refereeId     String   @unique
  rewardGranted Boolean  @default(false)
  createdAt     DateTime @default(now())

  referrer User @relation("ReferralsMade",     fields: [referrerId], references: [id])
  referee  User @relation("ReferralsReceived", fields: [refereeId],  references: [id])

  @@index([referrerId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

// Web Push API subscription per browser/device.
model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Expo push token per native device.
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-user notification preferences. Created on first access with all defaults enabled.
model NotificationSettings {
  userId            String  @id
  emailEnabled      Boolean @default(true)
  webPushEnabled    Boolean @default(true)
  nativePushEnabled Boolean @default(true)
  referralAlerts    Boolean @default(true)
  loginAlerts       Boolean @default(true)
  paymentAlerts     Boolean @default(true)
  renewalAlerts     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
