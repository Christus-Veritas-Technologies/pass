# ─── Core ─────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# URL of the web/frontend app — used for CORS and email links
CORS_ORIGIN=http://localhost:3001

# Runtime environment
NODE_ENV=development

# Base URL of this server — used for auth redirects and payment callbacks
APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random hex string, min 32 chars (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_min_32_chars_random_hex_string_here
JWT_REFRESH_SECRET=change_me_min_32_chars_another_random_hex_string

# ─── Anthropic (optional — AI features disabled when absent) ──────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Google OAuth (optional — Google sign-in disabled when absent) ────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── SMTP (optional — forgot-password email disabled when absent) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail app password (not your account password)
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=you@gmail.com

# ─── Cloudflare R2 (optional — file uploads disabled when absent) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pass-uploads
R2_PUBLIC_URL=

# ─── Paynow Payment Gateway (optional — payments disabled when absent) ────────
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=http://localhost:3000/api/payments/webhook
PAYNOW_RETURN_URL=http://localhost:3001/payments/success

# WhatsApp Client (whatsapp-web.js)
# Set to true to enable the WhatsApp bot on server startup
WHATSAPP_ENABLED=false
# Directory where wwebjs stores the LocalAuth session (relative to apps/server)
WHATSAPP_SESSION_DIR=./.wwebjs_auth
# Secret token for the GET /whatsapp/qr admin endpoint
WHATSAPP_ADMIN_TOKEN=your_admin_token_here
# E.164 phone number of the WhatsApp account the bot runs on (optional, for display)
WHATSAPP_BOT_NUMBER=+263XXXXXXXXX
