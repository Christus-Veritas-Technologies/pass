{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot --env-file=.env src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@mastra/core": "^1.37.1",
    "@mastra/memory": "^1.20.0",
    "@mastra/pg": "^1.11.1",
    "@pass/db": "workspace:*",
    "@pass/env": "workspace:*",
    "@pass/pricing": "workspace:*",
    "@react-pdf/renderer": "^4.5.1",
    "@types/react": "^19.2.15",
    "pdfkit": "^0.15.1",
    "@types/web-push": "^3.6.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.2",
    "hono": "^4.8.2",
    "jose": "^5.10.0",
    "marked": "^14.1.0",
    "nanoid": "^5.1.11",
    "nodemailer": "^6.10.1",
    "paynow": "^2.2.2",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.6",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.27.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@pass/config": "workspace:*",
    "@types/bun": "^1.3.4",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/pdfkit": "^0.13.9",
    "tsdown": "^0.21.9",
    "typescript": "^6"
  }
}
