{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@mastra/core": "^0.10.0",
    "@pass/db": "workspace:*",
    "@pass/env": "workspace:*",
    "ai": "^4.3.0",
    "dotenv": "catalog:",
    "hono": "^4.8.2",
    "jose": "^5.10.0",
    "nodemailer": "^6.10.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pass/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "tsdown": "^0.21.9",
    "typescript": "^6"
  }
}
