{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.3.11",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "bun": "1.3.11",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "bun": "1.3.11",
      "channel": "production",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
