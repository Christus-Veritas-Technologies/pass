# apps/native/.easignore — paths relative to apps/native/
# EAS also reads this file when eas.json lives in apps/native/.

# ── Android build caches ──────────────────────────────────────────────────────
android/.gradle
android/build
android/app/build
android/app/.cxx

# ── Expo local state ──────────────────────────────────────────────────────────
.expo

# ── Android extra caches ─────────────────────────────────────────────────────
android/.cxx

# ── node_modules ──────────────────────────────────────────────────────────────
node_modules
**/node_modules
