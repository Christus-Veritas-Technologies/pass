# EAS Build ignore file
# EAS archives the monorepo root — all paths are relative to the repo root.
# Learn more: https://expo.fyi/eas-build-archive

# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── All node_modules (EAS installs deps fresh on CI) ─────────────────────────
node_modules
**/node_modules

# ── Other apps in the monorepo (not needed for the native build) ─────────────
apps/web
apps/server

# ── Large asset packages ──────────────────────────────────────────────────────
# packages/papers contains ingested PDF files (can be hundreds of MB)
packages/papers
**/papers/**/*.pdf
**/papers/**/*.PDF

# ── Build / compiled output ───────────────────────────────────────────────────
apps/web/.next
apps/server/dist
dist
build
.turbo

# ── Android build caches (regenerated by Gradle on CI) ───────────────────────
apps/native/android/.gradle
apps/native/android/app/build
apps/native/android/build
**/.gradle
**/android/app/build

# ── WhatsApp session data ─────────────────────────────────────────────────────
**/.wwebjs_auth
**/wwebjs_auth

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Caches ───────────────────────────────────────────────────────────────────
.cache
.eslintcache
.next
tsc-incremental
**/.cache

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage
.nyc_output
*.lcov
__tests__
__test__

# ── Temporary / generated files ───────────────────────────────────────────────
*.tmp
*.temp
*.bak
yarn.lock
package-lock.json

# ── Docs (not needed in build archive) ───────────────────────────────────────
**/README.md
**/CHANGELOG.md
**/*.md
DEPLOYMENT.md
LANDING_PAGE_PLAN.md
WHATSAPP_AUTH_PLAN.md

# ── Local env overrides ───────────────────────────────────────────────────────
.env.local
.env.*.local
.env.example
.env.development

# ── Scripts (deploy scripts not needed) ──────────────────────────────────────
scripts
