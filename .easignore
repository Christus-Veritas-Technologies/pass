# ── EAS Build Archive Ignore ──────────────────────────────────────────────────
# EAS reinstalls all dependencies on their servers, so node_modules and build
# artifacts are safe to exclude. All workspace package.json files MUST be
# present in the archive so bun install resolves the same lockfile as locally.

# ── Workspace node_modules (reinstalled on EAS) ─────────────────────────────
node_modules/
apps/native/node_modules/
apps/web/node_modules/
apps/server/node_modules/
packages/env/node_modules/
packages/config/node_modules/
packages/db/node_modules/
packages/ui/node_modules/

# ── Build caches & outputs ─────────────────────────────────────────────────────
.turbo/
.next/
dist/
build/
*.tsbuildinfo
.cache/

# ── Dev / editor artifacts ──────────────────────────────────────────────────────
.DS_Store
*.log
.claude/
