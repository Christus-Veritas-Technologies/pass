# Root-level .easignore — paths relative to the repo root
# EAS archives the monorepo root; this file is the primary guard.

# ── Version control ───────────────────────────────────────────────────────────
.git

# ── Other apps (not needed for the Android build) ─────────────────────────────
apps/server
apps/web

# ── Large generated / downloaded assets ───────────────────────────────────────
packages/papers/papers
packages/papers/.ingest-cache
packages/papers/ingested.json

# ── node_modules — match at every depth ──────────────────────────────────────
**/node_modules

# ── Build outputs ─────────────────────────────────────────────────────────────
apps/web/.next
apps/server/dist
**/dist
**/.next

# ── Android build caches (large on dev machines) ──────────────────────────────
apps/native/android/.gradle
apps/native/android/build
apps/native/android/app/build
apps/native/android/app/.cxx
**/.gradle
**/build/intermediates
**/build/outputs
**/build/generated
**/build/tmp
**/build/kotlin
**/.cxx

# ── Expo / Metro local state ──────────────────────────────────────────────────
apps/native/.expo
**/.expo
**/.metro-cache
**/metro-cache

# ── EAS local cache ───────────────────────────────────────────────────────────
.eas

# ── WhatsApp session ──────────────────────────────────────────────────────────
apps/server/.wwebjs_auth

# ── Turbo / Nx caches ────────────────────────────────────────────────────────
.turbo
.nx
**/.turbo

# ── Scripts / docs ────────────────────────────────────────────────────────────
scripts
DEPLOYMENT.md
LANDING_PAGE_PLAN.md
WHATSAPP_AUTH_PLAN.md

# ── Logs & temp ───────────────────────────────────────────────────────────────
**/*.log
**/logs
tmp
temp
.cache
**/.cache
