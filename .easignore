# Root-level .easignore — repo-root-relative paths
# EAS archives the monorepo root; this guards the top level.

# ── Claude Code internal directory (large — projects, worktrees, caches) ──────
.claude/

# ── Version control ───────────────────────────────────────────────────────────
.git/

# ── Other apps (not needed for the Android build) ─────────────────────────────
apps/server/
apps/web/

# ── Papers package (large PDFs + scripts not needed for build) ────────────────
packages/papers/

# ── node_modules — explicit at every known location ──────────────────────────
node_modules/
apps/native/node_modules/
apps/web/node_modules/
apps/server/node_modules/
packages/db/node_modules/
packages/env/node_modules/
packages/ui/node_modules/
packages/config/node_modules/
packages/papers/node_modules/
packages/pricing/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
apps/web/.next/
apps/server/dist/
dist/
build/

# ── Android build caches ──────────────────────────────────────────────────────
apps/native/android/.gradle/
apps/native/android/build/
apps/native/android/app/build/
apps/native/android/app/.cxx/
apps/native/android/.cxx/

# ── Expo / Metro local state ──────────────────────────────────────────────────
apps/native/.expo/
.expo/

# ── EAS local cache ───────────────────────────────────────────────────────────
.eas/

# ── WhatsApp session ──────────────────────────────────────────────────────────
apps/server/.wwebjs_auth/

# ── Turbo / Nx caches ────────────────────────────────────────────────────────
.turbo/
.nx/

# ── Misc / logs ───────────────────────────────────────────────────────────────
tmp/
temp/
.cache/
logs/
